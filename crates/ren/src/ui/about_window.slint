import { AboutSlint, Button, ListView, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Logo } from "logo.slint";

// A block of the third-party notices: 0 heading, 1 paragraph, 2 a licence
// text (preformatted).
export struct NoticeBlock {
    kind: int,
    text: string,
}

// Help → About Ren, and on a second page the third-party notices.
export component AboutWindow inherits Window {
    in property <string> version;
    in property <string> source-url;
    in property <ColorScheme> forced-color-scheme: ColorScheme.unknown;
    callback open-source();
    // The notices, while their page is shown; `show-licenses` fills them,
    // `hide-licenses` drops them.
    in property <[NoticeBlock]> notices;
    in-out property <bool> licenses-shown;
    callback show-licenses();
    callback hide-licenses();
    callback close-requested();

    changed forced-color-scheme => {
        Palette.color-scheme = root.forced-color-scheme;
    }

    title: "About Ren";
    icon: Logo.large;
    preferred-width: 560px;
    // Wrapped text counts as one line in the preferred height.
    preferred-height: 480px;
    background: Palette.background;

    if root.licenses-shown: VerticalLayout {
        padding: 16px;
        spacing: 10px;

        Text {
            text: "Third-party licenses";
            font-size: 1.4rem;
            font-weight: 700;
            color: Palette.foreground;
        }

        ListView {
            vertical-stretch: 1;

            for block in root.notices: VerticalLayout {
                padding-top: block.kind == 0 ? 12px : 4px;
                padding-bottom: 4px;
                padding-right: 12px;

                if block.kind == 2: Rectangle {
                    background: Palette.alternate-background;
                    border-radius: 4px;
                    height: pre-text.preferred-height + 16px;

                    pre-text := Text {
                        x: 8px;
                        y: 8px;
                        width: parent.width - 16px;
                        text: block.text;
                        wrap: word-wrap;
                        font-family: "monospace";
                        font-size: 0.85rem;
                        color: Palette.foreground;
                    }
                }

                if block.kind != 2: Text {
                    text: block.text;
                    wrap: word-wrap;
                    font-weight: block.kind == 0 ? 700 : 400;
                    font-size: block.kind == 0 ? 1.1rem : 1rem;
                    color: Palette.foreground;
                }
            }
        }

        HorizontalLayout {
            alignment: end;
            spacing: 8px;

            Button {
                text: "Back";
                clicked => {
                    root.licenses-shown = false;
                    root.hide-licenses();
                }
            }

            Button {
                text: "Close";
                primary: true;
                clicked => {
                    root.close-requested();
                }
            }
        }
    }

    if !root.licenses-shown: VerticalLayout {
        padding: 24px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 16px;
            alignment: start;

            Image {
                width: 64px;
                height: 64px;
                source: Logo.large;
            }

            VerticalLayout {
                alignment: center;
                spacing: 4px;

                Text {
                    text: "Ren";
                    font-size: 1.8rem;
                    font-weight: 700;
                    color: Palette.foreground;
                }

                Text {
                    text: "Version " + root.version + " · A native Nextcloud News reader";
                    color: Palette.foreground;
                    opacity: 0.8;
                }
            }
        }

        Text {
            text: "Copyright 2026 Heinz Wiesinger";
            color: Palette.foreground;
        }

        Text {
            text: "Ren is free software: you can redistribute it and/or modify it under the terms of the GNU General Public License as published by the Free Software Foundation, either version 3 of the License, or (at your option) any later version. It is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU General Public License for more details.";
            wrap: word-wrap;
            font-size: 0.9rem;
            color: Palette.foreground;
            opacity: 0.8;
        }

        HorizontalLayout {
            alignment: start;

            Text {
                text: root.source-url;
                color: Palette.accent-background;

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.open-source();
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.separator;
        }

        Text {
            text: "Built with Slint (the window), Blitz (articles), Servo (web pages in tabs) and Brave's adblock-rust, for the Nextcloud News app. The bundled icons are Lucide's; the logo, a wire-frame lotus, is Ren's own.";
            wrap: word-wrap;
            color: Palette.foreground;
        }

        AboutSlint {
            height: 110px;
        }

        Rectangle {
            vertical-stretch: 1;
        }

        HorizontalLayout {
            vertical-stretch: 0;
            alignment: end;
            spacing: 8px;

            Button {
                text: "Third-Party Licenses";
                clicked => {
                    root.show-licenses();
                    root.licenses-shown = true;
                }
            }

            Button {
                text: "Close";
                primary: true;
                clicked => {
                    root.close-requested();
                }
            }
        }
    }
}
