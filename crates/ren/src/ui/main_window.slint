import { Button, LineEdit, Palette, ScrollView } from "std-widgets.slint";
import { FeedTree, FeedRow } from "feed_tree.slint";
import { ItemTable, ItemRow, ItemStatus } from "item_table.slint";
import { Splitter } from "splitter.slint";
import { StatusBar, ToolBar, ToolButton } from "toolbar.slint";
import { TabBar, TabRow } from "tab_bar.slint";
import { PageMenu, PageOption, SelectPopup } from "page_controls.slint";
import { Tray } from "tray.slint";
import { CategoryEntry, SettingsWindow, SettingRow } from "settings_window.slint";
import { AboutWindow, NoticeBlock } from "about_window.slint";
import { ConfirmWindow } from "confirm_window.slint";
import { FeedDialog, FeedDialogKind } from "feed_dialog.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Logo } from "logo.slint";
import { BrokenFeed, WelcomePage } from "welcome.slint";

export { AboutWindow, BrokenFeed, CategoryEntry, ConfirmWindow, FeedDialog, FeedDialogKind, NoticeBlock, FeedRow, ItemRow, ItemStatus, Icons, PageMenu, PageOption, SettingRow, SettingsWindow, TabRow, Theme, Tray }

// Where the item list goes relative to the article.
export enum Arrangement {
    // Item list left of the article, with compact two-line rows.
    beside,
    // Item list above the article, as a table (akregator's default).
    above,
}

export component MainWindow inherits Window {
    in property <[FeedRow]> feeds;
    in property <[ItemRow]> items;
    in-out property <int> current-feed: 0;
    in-out property <int> current-item: -1;
    // The article shown is starred.
    in property <bool> current-starred;
    in property <string> article-title;
    in property <string> article-meta;
    in property <string> article-body;
    in-out property <length> article-content-y <=> article.content-y;

    // The article rendered as HTML (Blitz) instead of plain text: an image
    // of the visible part, with input forwarded to the renderer.
    in property <bool> html-view;
    in property <image> article-image;
    // 0 default, 1 pointer (links), 2 text.
    in property <int> article-cursor;
    out property <length> article-width: html-area.width;
    out property <length> article-height: html-area.height;
    // The article has images that weren't loaded (`articles.load-images`
    // is off).
    in property <bool> article-images-blocked;
    // The article's scroll position and the largest one (0 if it fits),
    // for the scroll indicator: Blitz draws none for the viewport.
    in property <length> article-scroll-y;
    in property <length> article-scroll-max;
    // Colours for the article stylesheet.
    out property <brush> article-background: Palette.background;
    out property <brush> article-foreground: Palette.foreground;
    out property <brush> article-link: Palette.accent-background;
    out property <bool> dark: Theme.dark;
    // kind: 0 down, 1 up, 2 move; button: 0 left, 1 middle, 2 right;
    // mods: 1 control, 2 shift, 4 alt, 8 meta.
    callback article-pointer(kind: int, button: int, x: length, y: length, mods: int);
    callback article-scroll(dx: length, dy: length, mods: int);
    callback article-scroll-to(y: length);
    // Scrolling by keyboard, smoothly; positive towards the top.
    callback article-key-scroll(dy: length);
    // The next frame of a keyboard or wheel scroll (from a timer).
    callback article-glide();
    callback article-key(text: string, mods: int) -> bool;
    callback article-resized();
    callback article-theme-changed();
    callback article-copy();
    callback article-select-all();
    // The URL of the link at a position in the article, or "".
    callback article-link-at(x: length, y: length) -> string;
    // A link in the article: action "open" (clicked with any button, or
    // the context menu's "Open Link in Tab"), "browser" or "copy".
    callback article-link-action(url: string, action: string);
    // No article is shown: the welcome page is, with Ren's version, the
    // counts and the last sync.
    in property <bool> welcome: true;
    in property <string> version;
    in property <string> welcome-articles;
    in property <string> welcome-sync;
    in property <bool> logged-in;
    in property <[BrokenFeed]> broken-feeds;

    // Whether links can open in tabs (built with Servo).
    in property <bool> tabs-available;
    // Called when the HTML view needs to be rendered again (from a wake-up).
    callback article-render();

    changed dark => {
        root.article-theme-changed();
        root.page-theme-changed();
        root.action("theme-changed");
    }

    // Web pages in tabs next to the article (Servo); current-tab -1 shows
    // the article. The page is an image of the visible part, with input
    // forwarded to Servo, like the HTML article view.
    in property <[TabRow]> tabs;
    in-out property <int> current-tab: -1;
    in property <image> page-image;
    // The article's frames are dropped while a page is shown and painted
    // again when the article is.
    changed current-tab => {
        root.article-render();
    }
    // 0 default, 1 pointer, 2 text.
    in property <int> page-cursor;
    // The navigation bar above the page.
    in property <string> page-url;
    in property <bool> page-can-go-back;
    in property <bool> page-can-go-forward;
    // Content blocking is on, and whether it blocks on the page's site.
    in property <bool> page-can-block;
    in property <bool> page-blocking;
    out property <length> page-width: page-area.width;
    out property <length> page-height: page-area.height;
    callback tab-selected(index: int);
    callback tab-closed(index: int);
    // As for the article, with buttons 3 (back) and 4 (forward);
    // positions are relative to the page.
    callback page-pointer(kind: int, button: int, x: length, y: length, mods: int);
    // "back", "forward" or "reload" in the page shown.
    callback page-navigate(action: string);
    callback page-scroll(dx: length, dy: length, x: length, y: length);
    callback page-key(text: string, mods: int, down: bool);
    callback page-resized();
    callback page-theme-changed();
    // Called when Servo has work for the UI thread (from a wake-up).
    callback page-pump();
    // The context menu of the page shown, and its entries' actions:
    // "open-link", "browser-link", "copy-link", "open-image",
    // "copy-image", "cut", "copy", "paste", "select-all", "back",
    // "forward", "reload".
    in property <PageMenu> page-menu;
    callback page-menu-action(action: string);
    // A drop-down of the page shown: its options, and where the element
    // is (relative to the page).
    in property <[PageOption]> page-options;
    in property <length> page-select-x;
    in property <length> page-select-y;
    in property <length> page-select-width;
    in property <length> page-select-height;
    callback page-select-chosen(index: int);

    // Opens the page's context menu at a position relative to the page.
    public function show-page-menu(x: length, y: length) {
        page-menu-area.show({ x: x, y: y });
    }

    // Opens and closes the page's drop-down.
    public function show-page-select() {
        select-popup.show();
    }

    public function close-page-select() {
        select-popup.close();
    }

    in-out property <Arrangement> arrangement: Arrangement.beside;
    // Pane sizes, changed by the splitters.
    in-out property <length> tree-width: 240px;
    in-out property <length> list-width: 420px;
    in-out property <length> list-height: 300px;
    // Widths of the item table's columns, changed by dragging their edges.
    in-out property <length> feed-width <=> item-list.feed-width;
    in-out property <length> author-width <=> item-list.author-width;
    in-out property <length> date-width <=> item-list.date-width;
    // The arrangement changed (View menu), so that each one keeps its own
    // pane sizes.
    callback arrangement-changed();

    changed arrangement => {
        root.arrangement-changed();
    }

    // For the autoscroll measurement.
    in-out property <length> item-list-content-y <=> item-list.content-y;
    out property <length> item-list-scroll-range: item-list.scroll-range;
    in property <int> sort-column: 3;
    in property <bool> sort-ascending: false;

    in property <string> status-text;
    // A sync is running.
    in property <bool> syncing;
    // The sync thread has news for the UI thread (from a wake-up).
    callback sync-event();
    in property <string> unread-text;
    in-out property <bool> show-toolbar: true;
    // Overrides the desktop's colour scheme unless `unknown`.
    in property <ColorScheme> forced-color-scheme: ColorScheme.unknown;

    // The shortcuts that stay the window's while a page has the focus: the
    // menu's, but for those a page needs too (Ctrl+Return submits forms)
    // and the browser's reload (`reload-key`). Editing keys (Ctrl+C,
    // Ctrl+A, …) and others go only to the page.
    pure function window-key(event: KeyEvent) -> bool {
        let m = event.modifiers;
        if m.alt && !m.control && !m.shift && !m.meta {
            return event.text == Key.LeftArrow || event.text == Key.RightArrow;
        }
        if !m.control || m.alt || m.meta {
            return false;
        }
        if m.shift {
            return event.text == Key.UpArrow || event.text == Key.DownArrow || event.text == "A" || event.text == "a" || event.text == "N" || event.text == "n" || event.text == "R" || event.text == "r";
        }
        event.text == "w" || event.text == "q" || event.text == "f" || event.text == "l" || event.text == "u"
    }

    // F5 and Ctrl+R reload a page that has the focus, as in a browser,
    // instead of fetching the feeds and marking a feed read.
    pure function reload-key(event: KeyEvent) -> bool {
        let m = event.modifiers;
        (event.text == Key.F5 && !m.control && !m.alt && !m.meta) || (m.control && !m.shift && !m.alt && !m.meta && event.text == "r")
    }

    changed forced-color-scheme => {
        Palette.color-scheme = root.forced-color-scheme;
    }

    // Ren was started again; the token is the launcher's activation token,
    // or "".
    callback activate(token: string);
    // A menu, tool bar or shortcut action, by name.
    callback action(name: string);
    // An action from the context menu of a feed tree row or an item.
    callback feed-menu(row: int, action: string);
    callback item-menu(row: int, action: string);
    callback search-edited(text: string);

    callback feed-clicked(row: int);
    callback feed-toggled(row: int);
    callback feed-key(key: string);
    callback item-clicked(row: int);
    callback item-key(key: string, page: int);
    callback sort-clicked(column: int);

    // Puts text on the clipboard, Slint's (the platform's): through a
    // hidden text input, as Slint has no other way to it.
    public function copy-text(text: string) {
        clipboard.text = text;
        clipboard.select-all();
        clipboard.copy();
        clipboard.text = "";
    }

    title: "Ren";
    icon: Logo.large;
    forward-focus: tree;
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Palette.background;

    clipboard := TextInput {
        visible: false;
        width: 0px;
        height: 0px;
    }

    MenuBar {
        Menu {
            title: "File";
            MenuItem {
                title: "Import Feeds…";
                activated => {
                    root.action("import");
                }
            }
            MenuItem {
                title: "Export Feeds…";
                activated => {
                    root.action("export");
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Close Tab";
                enabled: root.current-tab >= 0;
                shortcut: @keys(Control + W);
                activated => {
                    root.action("close-tab");
                }
            }
            MenuItem {
                title: "Quit";
                icon: Icons.quit;
                shortcut: @keys(Control + Q);
                activated => {
                    root.action("quit");
                }
            }
        }

        Menu {
            title: "Edit";
            MenuItem {
                title: "Find Articles…";
                icon: Icons.find;
                shortcut: @keys(Control + F);
                activated => {
                    search.focus();
                    search.select-all();
                }
            }
        }

        Menu {
            title: "View";
            beside-item := MenuItem {
                title: "Article List Beside Article";
                checkable: true;
                checked: root.arrangement == Arrangement.beside;
                activated => {
                    root.arrangement = Arrangement.beside;
                    beside-item.checked = true;
                    above-item.checked = false;
                }
            }
            above-item := MenuItem {
                title: "Article List Above Article";
                checkable: true;
                checked: root.arrangement == Arrangement.above;
                activated => {
                    root.arrangement = Arrangement.above;
                    beside-item.checked = false;
                    above-item.checked = true;
                }
            }
            MenuSeparator { }
            Menu {
                title: "Sort Articles By";
                MenuItem {
                    title: "Title";
                    activated => {
                        root.action("sort-title");
                    }
                }
                MenuItem {
                    title: "Feed";
                    activated => {
                        root.action("sort-feed");
                    }
                }
                MenuItem {
                    title: "Author";
                    activated => {
                        root.action("sort-author");
                    }
                }
                MenuItem {
                    title: "Date";
                    activated => {
                        root.action("sort-date");
                    }
                }
            }
        }

        Menu {
            title: "Go";
            MenuItem {
                title: "Previous Article";
                shortcut: @keys(Control + Shift + UpArrow);
                activated => {
                    root.action("previous-article");
                }
            }
            MenuItem {
                title: "Next Article";
                shortcut: @keys(Control + Shift + DownArrow);
                activated => {
                    root.action("next-article");
                }
            }
            MenuItem {
                title: "Next Unread Article";
                shortcut: @keys(Control + Shift + N);
                activated => {
                    root.action("next-unread");
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Back";
                icon: Icons.back;
                enabled: root.current-tab >= 0 && root.page-can-go-back;
                shortcut: @keys(Alt + LeftArrow);
                activated => {
                    root.page-navigate("back");
                }
            }
            MenuItem {
                title: "Forward";
                icon: Icons.forward;
                enabled: root.current-tab >= 0 && root.page-can-go-forward;
                shortcut: @keys(Alt + RightArrow);
                activated => {
                    root.page-navigate("forward");
                }
            }
        }

        Menu {
            title: "Feed";
            MenuItem {
                title: "Add Feed…";
                icon: Icons.add-feed;
                shortcut: @keys(Control + Shift + A);
                activated => {
                    root.action("add-feed");
                }
            }
            MenuItem {
                title: "Fetch Feed";
                icon: Icons.fetch-feed;
                shortcut: @keys(F5);
                activated => {
                    root.action("fetch-feed");
                }
            }
            MenuItem {
                title: "Fetch All Feeds";
                icon: Icons.fetch-all;
                shortcut: @keys(Control + L);
                activated => {
                    root.action("fetch-all");
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Mark Feed as Read";
                icon: Icons.mark-read;
                shortcut: @keys(Control + R);
                activated => {
                    root.action("mark-feed-read");
                }
            }
            MenuItem {
                title: "Mark All Feeds as Read";
                shortcut: @keys(Control + Shift + R);
                activated => {
                    root.action("mark-all-read");
                }
            }
        }

        Menu {
            title: "Article";
            MenuItem {
                title: "Open Link in Tab";
                enabled: root.tabs-available;
                shortcut: @keys(Control + Return);
                activated => {
                    root.action("open-tab");
                }
            }
            MenuItem {
                title: "Open Link in External Browser";
                activated => {
                    root.action("open-browser");
                }
            }
            MenuItem {
                title: "Load Images";
                enabled: root.article-images-blocked;
                activated => {
                    root.action("load-images");
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Mark as Read";
                activated => {
                    root.action("mark-read");
                }
            }
            MenuItem {
                title: "Mark as Unread";
                shortcut: @keys(Control + U);
                activated => {
                    root.action("mark-unread");
                }
            }
            MenuItem {
                title: root.current-starred ? "Remove Star" : "Star";
                activated => {
                    root.action("toggle-star");
                }
            }
        }

        Menu {
            title: "Settings";
            toolbar-item := MenuItem {
                title: "Show Toolbar";
                checkable: true;
                checked: root.show-toolbar;
                activated => {
                    root.show-toolbar = toolbar-item.checked;
                }
            }
            MenuItem {
                title: "Clear Web Site Data";
                enabled: root.tabs-available;
                activated => {
                    root.action("clear-site-data");
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Configure Ren…";
                icon: Icons.configure;
                activated => {
                    root.action("configure");
                }
            }
        }

        Menu {
            title: "Help";
            MenuItem {
                title: "About Ren";
                activated => {
                    root.action("about");
                }
            }
        }
    }

    // Single keys for reading: the feed tree, the item list and the
    // article pass on the keys they don't take (the search field and pages
    // take all of them). j/k: next/previous article, s: star, m: read or
    // unread, o: open the link.
    FocusScope {
        // Only hears what the others pass on; never takes the focus.
        enabled: false;

        key-pressed(event) => {
            if event.modifiers.control || event.modifiers.alt || event.modifiers.meta {
                return reject;
            }
            if event.text == "j" {
                root.action("next-article");
            } else if event.text == "k" {
                root.action("previous-article");
            } else if event.text == "s" {
                root.action("toggle-star");
            } else if event.text == "m" {
                root.action("toggle-read");
            } else if event.text == "o" {
                root.action("open-tab");
            } else {
                return reject;
            }
            accept
        }

        VerticalLayout {
            if root.show-toolbar: ToolBar {
                ToolButton {
                    icon: Icons.add-feed;
                    text: "Add Feed";
                    clicked => {
                        root.action("add-feed");
                    }
                }

                ToolButton {
                    icon: Icons.fetch-feed;
                    text: "Fetch Feed";
                    clicked => {
                        root.action("fetch-feed");
                    }
                }

                ToolButton {
                    icon: Icons.fetch-all;
                    text: "Fetch All Feeds";
                    clicked => {
                        root.action("fetch-all");
                    }
                }

                ToolButton {
                    icon: Icons.cancel;
                    text: "Cancel Feed Fetches";
                    enabled: root.syncing;
                    clicked => {
                        root.action("cancel-sync");
                    }
                }

                ToolButton {
                    icon: Icons.mark-read;
                    text: "Mark Feed as Read";
                    clicked => {
                        root.action("mark-feed-read");
                    }
                }
            }

            HorizontalLayout {
                tree := FeedTree {
                    width: root.tree-width;
                    rows: root.feeds;
                    current: root.current-feed;
                    tabs-available: root.tabs-available;
                    select(row) => {
                        root.feed-clicked(row);
                    }
                    toggle(row) => {
                        root.feed-toggled(row);
                    }
                    navigate(key) => {
                        root.feed-key(key);
                    }
                    menu(row, action) => {
                        root.feed-menu(row, action);
                    }
                }

                Splitter {
                    width: 5px;
                    size <=> root.tree-width;
                    min-size: 150px;
                    max-size: 600px;
                }

                // The item list and the article, arranged by hand so that both
                // arrangements share the same element instances (and with them
                // selection, focus and scroll positions).
                content := Rectangle {
                    horizontal-stretch: 1;

                    property <bool> beside: root.arrangement == Arrangement.beside;
                    property <length> bar: 5px;
                    property <length> search-height: 34px;
                    property <length> tabs-height: root.tabs.length > 0 ? 30px : 0px;

                    search-box := Rectangle {
                        x: 0px;
                        y: 0px;
                        width: item-list.width;
                        height: content.search-height;

                        search := LineEdit {
                            x: 4px;
                            y: 3px;
                            width: parent.width - 8px;
                            height: parent.height - 6px;
                            placeholder-text: "Search articles…";
                            edited(text) => {
                                root.search-edited(text);
                            }
                            key-pressed(event) => {
                                // Down moves on to the list.
                                if event.text == Key.DownArrow || event.text == Key.Return {
                                    item-list.focus();
                                    return accept;
                                }
                                reject
                            }
                        }
                    }

                    item-list := ItemTable {
                        x: 0px;
                        y: content.search-height;
                        width: content.beside ? root.list-width : content.width;
                        height: (content.beside ? content.height : root.list-height) - content.search-height;
                        compact: content.beside;
                        tabs-available: root.tabs-available;
                        rows: root.items;
                        current: root.current-item;
                        sort-column: root.sort-column;
                        sort-ascending: root.sort-ascending;
                        select(row) => {
                            root.item-clicked(row);
                        }
                        navigate(key, page) => {
                            root.item-key(key, page);
                        }
                        sort(column) => {
                            root.sort-clicked(column);
                        }
                        menu(row, action) => {
                            root.item-menu(row, action);
                        }
                    }

                    Splitter {
                        visible: content.beside;
                        vertical: true;
                        x: root.list-width;
                        width: content.bar;
                        height: content.height;
                        size <=> root.list-width;
                        min-size: 250px;
                        max-size: content.width - 250px;
                    }

                    Splitter {
                        visible: !content.beside;
                        vertical: false;
                        y: root.list-height;
                        width: content.width;
                        height: content.bar;
                        size <=> root.list-height;
                        min-size: 100px;
                        max-size: content.height - 100px;
                    }

                    TabBar {
                        visible: root.tabs.length > 0;
                        x: article.x;
                        y: article.y - content.tabs-height;
                        width: article.width;
                        height: content.tabs-height;
                        tabs: root.tabs;
                        current: root.current-tab;
                        select(index) => {
                            root.tab-selected(index);
                        }
                        close(index) => {
                            root.tab-closed(index);
                        }
                    }

                    article := ScrollView {
                        visible: !root.html-view && root.current-tab < 0;
                        x: content.beside ? root.list-width + content.bar : 0px;
                        y: (content.beside ? 0px : root.list-height + content.bar) + content.tabs-height;
                        width: content.width - self.x;
                        height: content.height - self.y;
                        content-width: self.visible-width;
                        content-height: article-layout.preferred-height;

                        article-layout := VerticalLayout {
                            width: article.visible-width;
                            padding: 16px;
                            spacing: 8px;
                            alignment: start;

                            Text {
                                text: root.article-title;
                                wrap: word-wrap;
                                font-size: 1.5rem;
                                font-weight: 700;
                                color: Palette.foreground;
                            }

                            Text {
                                text: root.article-meta;
                                wrap: word-wrap;
                                color: Palette.foreground;
                                opacity: 0.7;
                            }

                            Text {
                                text: root.article-body;
                                wrap: word-wrap;
                                color: Palette.foreground;
                            }
                        }
                    }

                    html-pane := Rectangle {
                        visible: root.html-view && root.current-tab < 0;
                        x: article.x;
                        y: article.y;
                        width: article.width;
                        height: article.height;
                        background: Palette.background;
                        clip: true;

                        // Offers to load the images that weren't loaded.
                        images-bar := Rectangle {
                            visible: root.article-images-blocked;
                            // Not centred, as children without a position are.
                            y: 0;
                            width: parent.width;
                            height: self.visible ? images-bar-layout.preferred-height : 0px;
                            background: Theme.hover;

                            images-bar-layout := HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                padding-top: 4px;
                                padding-bottom: 4px;
                                spacing: 12px;

                                Text {
                                    text: "Images from other servers were not loaded.";
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    color: Palette.foreground;
                                }

                                Button {
                                    text: "Load Images";
                                    horizontal-stretch: 0;
                                    clicked => {
                                        root.action("load-images");
                                    }
                                }
                            }
                        }

                        html-area := Rectangle {
                            y: images-bar.height;
                            width: parent.width;
                            height: parent.height - images-bar.height;

                            changed width => {
                                root.article-resized();
                            }
                            changed height => {
                                root.article-resized();
                            }

                            // Only while the article is shown: the renderer keeps the
                            // last image of an element it no longer draws.
                            if root.html-view && root.current-tab < 0: Image {
                                width: parent.width;
                                height: parent.height;
                                source: root.article-image;
                                image-fit: fill;
                            }

                            html-focus := FocusScope {
                                // Scrolling by keyboard; deltas are positive towards the
                                // top, as for the mouse wheel.
                                property <length> line: 40px;
                                property <length> page: html-area.height * 0.9;

                                key-pressed(event) => {
                                    if event.modifiers.control || event.modifiers.alt || event.modifiers.meta {
                                        if root.article-key(event.text, html-pane.mods(event.modifiers)) {
                                            return accept;
                                        }
                                        return reject;
                                    }
                                    if event.text == Key.UpArrow {
                                        root.article-key-scroll(self.line);
                                    } else if event.text == Key.DownArrow {
                                        root.article-key-scroll(-self.line);
                                    } else if event.text == Key.PageUp || (event.text == " " && event.modifiers.shift) {
                                        root.article-key-scroll(self.page);
                                    } else if event.text == Key.PageDown || event.text == " " {
                                        root.article-key-scroll(-self.page);
                                    } else if event.text == Key.Home {
                                        root.article-key-scroll(1000000px);
                                    } else if event.text == Key.End {
                                        root.article-key-scroll(-1000000px);
                                    } else {
                                        return reject;
                                    }
                                    accept
                                }
                            }

                            // The link under the pointer when the menu opened.
                            property <string> menu-link;

                            article-menu := ContextMenuArea {
                                Menu {
                                    if html-area.menu-link != "" && root.tabs-available: MenuItem {
                                        title: "Open Link in Tab";
                                        activated => {
                                            root.article-link-action(html-area.menu-link, "open");
                                        }
                                    }
                                    if html-area.menu-link != "": MenuItem {
                                        title: "Open Link in Browser";
                                        activated => {
                                            root.article-link-action(html-area.menu-link, "browser");
                                        }
                                    }
                                    if html-area.menu-link != "": MenuItem {
                                        title: "Copy Link Address";
                                        activated => {
                                            root.article-link-action(html-area.menu-link, "copy");
                                        }
                                    }
                                    if html-area.menu-link != "": MenuSeparator { }
                                    MenuItem {
                                        title: "Copy";
                                        activated => {
                                            root.article-copy();
                                        }
                                    }
                                    MenuItem {
                                        title: "Select All";
                                        activated => {
                                            root.article-select-all();
                                        }
                                    }
                                }

                                TouchArea {
                                    mouse-cursor: root.article-cursor == 1 ? MouseCursor.pointer : root.article-cursor == 2 ? MouseCursor.text : MouseCursor.default;
                                    pointer-event(event) => {
                                        if event.kind == PointerEventKind.down {
                                            html-focus.focus();
                                        }
                                        // This TouchArea takes the right click before the
                                        // ContextMenuArea sees it; open the menu here, and
                                        // keep the click from Blitz so the selection stays.
                                        if event.button == PointerEventButton.right {
                                            if event.kind == PointerEventKind.down {
                                                html-area.menu-link = root.article-link-at(self.mouse-x, self.mouse-y);
                                                article-menu.show({ x: self.mouse-x, y: self.mouse-y });
                                            }
                                            return;
                                        }
                                        if event.kind != PointerEventKind.cancel {
                                            root.article-pointer(
                                                event.kind == PointerEventKind.down ? 0 : event.kind == PointerEventKind.up ? 1 : 2,
                                                event.button == PointerEventButton.middle ? 1 : event.button == PointerEventButton.right ? 2 : 0,
                                                self.mouse-x,
                                                self.mouse-y,
                                                html-pane.mods(event.modifiers));
                                        }
                                    }
                                    scroll-event(event) => {
                                        root.article-scroll(event.delta-x, event.delta-y, html-pane.mods(event.modifiers));
                                        accept
                                    }
                                }
                            }

                            // The scroll position, over the right edge of the article;
                            // the thumb can be dragged.
                            scroll-track := Rectangle {
                                visible: root.article-scroll-max > 0;
                                x: parent.width - self.width;
                                width: 14px;
                                height: parent.height;

                                property <length> content: html-area.height + root.article-scroll-max;
                                property <length> thumb-height: max(24px, self.height * html-area.height / self.content);
                                property <length> travel: self.height - self.thumb-height;
                                property <bool> active: track-area.has-hover || track-area.pressed;

                                thumb := Rectangle {
                                    x: parent.width - self.width - 3px;
                                    y: parent.travel * root.article-scroll-y / max(1px, root.article-scroll-max);
                                    width: parent.active ? 8px : 4px;
                                    height: parent.thumb-height;
                                    border-radius: self.width / 2;
                                    background: Palette.foreground;
                                    opacity: parent.active ? 0.45 : 0.25;

                                    animate width, opacity { duration: 100ms; }
                                }

                                track-area := TouchArea {
                                    // Where the thumb was grabbed, from its top.
                                    property <length> grab;

                                    function scroll-to-pointer() {
                                        root.article-scroll-to(
                                            (self.mouse-y - self.grab) / max(1px, scroll-track.travel) * root.article-scroll-max);
                                    }

                                    pointer-event(event) => {
                                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                            if self.mouse-y >= thumb.y && self.mouse-y <= thumb.y + thumb.height {
                                                self.grab = self.mouse-y - thumb.y;
                                            } else {
                                                // Centred on the pointer.
                                                self.grab = thumb.height / 2;
                                                self.scroll-to-pointer();
                                            }
                                        }
                                    }
                                    moved => {
                                        if self.pressed {
                                            self.scroll-to-pointer();
                                        }
                                    }
                                    scroll-event(event) => {
                                        root.article-scroll(event.delta-x, event.delta-y, html-pane.mods(event.modifiers));
                                        accept
                                    }
                                }
                            }

                        }

                        pure function mods(m: KeyboardModifiers) -> int {
                            return (m.control ? 1 : 0) + (m.shift ? 2 : 0) + (m.alt ? 4 : 0) + (m.meta ? 8 : 0);
                        }
                    }

                    WelcomePage {
                        visible: root.welcome && root.current-tab < 0;
                        x: article.x;
                        y: article.y;
                        width: article.width;
                        height: article.height;
                        version: root.version;
                        articles: root.welcome-articles;
                        sync: root.welcome-sync;
                        logged-in: root.logged-in;
                        broken: root.broken-feeds;
                        action(name) => {
                            root.action(name);
                        }
                    }

                    page-pane := Rectangle {
                        visible: root.current-tab >= 0;
                        x: article.x;
                        y: article.y;
                        width: article.width;
                        height: article.height;
                        clip: true;

                        changed visible => {
                            if self.visible {
                                page-focus.focus();
                            }
                        }

                        // Back, forward, reload, the address, and the system
                        // browser.
                        page-bar := Rectangle {
                            y: 0;
                            width: parent.width;
                            height: page-bar-layout.preferred-height;
                            background: Palette.alternate-background;

                            page-bar-layout := HorizontalLayout {
                                padding: 2px;
                                spacing: 2px;

                                ToolButton {
                                    icon: Icons.back;
                                    enabled: root.page-can-go-back;
                                    clicked => {
                                        root.page-navigate("back");
                                    }
                                }

                                ToolButton {
                                    icon: Icons.forward;
                                    enabled: root.page-can-go-forward;
                                    clicked => {
                                        root.page-navigate("forward");
                                    }
                                }

                                ToolButton {
                                    icon: Icons.reload;
                                    clicked => {
                                        root.page-navigate("reload");
                                    }
                                }

                                Text {
                                    horizontal-stretch: 1;
                                    text: root.page-url;
                                    overflow: elide;
                                    vertical-alignment: center;
                                    color: Palette.foreground;
                                    opacity: 0.8;
                                }

                                if root.page-can-block: ToolButton {
                                    text: root.page-blocking ? "Allow Ads Here" : "Block Ads Here";
                                    clicked => {
                                        root.action("toggle-site-blocking");
                                    }
                                }

                                ToolButton {
                                    icon: Icons.browser;
                                    text: "Open in Browser";
                                    clicked => {
                                        root.action("page-browser");
                                    }
                                }
                            }

                            Rectangle {
                                y: parent.height - 1px;
                                height: 1px;
                                background: Theme.separator;
                            }
                        }

                        page-area := Rectangle {
                            y: page-bar.height;
                            width: parent.width;
                            height: parent.height - page-bar.height;
                            // The frame covers it all; filling the background below
                            // it too would cost a pass over every pixel per frame.
                            background: root.page-image.width > 0 ? transparent : Palette.background;

                            changed width => {
                                root.page-resized();
                            }
                            changed height => {
                                root.page-resized();
                            }

                            // Only while a page is shown: the renderer keeps the last
                            // image of an element it no longer draws.
                            if root.current-tab >= 0: Image {
                                width: parent.width;
                                height: parent.height;
                                source: root.page-image;
                                image-fit: fill;
                            }

                            // Shown by the window when Servo asks for it, after a
                            // right click that went to the page (the TouchArea
                            // above takes the clicks).
                            page-menu-area := ContextMenuArea {
                                Menu {
                                    if root.page-menu.link != "": MenuItem {
                                        title: "Open Link in New Tab";
                                        activated => {
                                            root.page-menu-action("open-link");
                                        }
                                    }
                                    if root.page-menu.link != "": MenuItem {
                                        title: "Open Link in Browser";
                                        activated => {
                                            root.page-menu-action("browser-link");
                                        }
                                    }
                                    if root.page-menu.link != "": MenuItem {
                                        title: "Copy Link Address";
                                        activated => {
                                            root.page-menu-action("copy-link");
                                        }
                                    }
                                    if root.page-menu.image != "": MenuItem {
                                        title: "Open Image in New Tab";
                                        activated => {
                                            root.page-menu-action("open-image");
                                        }
                                    }
                                    if root.page-menu.image != "": MenuItem {
                                        title: "Copy Image Address";
                                        activated => {
                                            root.page-menu-action("copy-image");
                                        }
                                    }
                                    if root.page-menu.link != "" || root.page-menu.image != "": MenuSeparator { }
                                    MenuItem {
                                        title: "Cut";
                                        enabled: root.page-menu.cut;
                                        activated => {
                                            root.page-menu-action("cut");
                                        }
                                    }
                                    MenuItem {
                                        title: "Copy";
                                        enabled: root.page-menu.copy;
                                        activated => {
                                            root.page-menu-action("copy");
                                        }
                                    }
                                    MenuItem {
                                        title: "Paste";
                                        enabled: root.page-menu.paste;
                                        activated => {
                                            root.page-menu-action("paste");
                                        }
                                    }
                                    MenuItem {
                                        title: "Select All";
                                        enabled: root.page-menu.select-all;
                                        activated => {
                                            root.page-menu-action("select-all");
                                        }
                                    }
                                    MenuSeparator { }
                                    MenuItem {
                                        title: "Back";
                                        icon: Icons.back;
                                        enabled: root.page-menu.back;
                                        activated => {
                                            root.page-menu-action("back");
                                        }
                                    }
                                    MenuItem {
                                        title: "Forward";
                                        icon: Icons.forward;
                                        enabled: root.page-menu.forward;
                                        activated => {
                                            root.page-menu-action("forward");
                                        }
                                    }
                                    MenuItem {
                                        title: "Reload";
                                        icon: Icons.reload;
                                        enabled: root.page-menu.reload;
                                        activated => {
                                            root.page-menu-action("reload");
                                        }
                                    }
                                    MenuSeparator { }
                                    MenuItem {
                                        title: "Open Page in Browser";
                                        icon: Icons.browser;
                                        activated => {
                                            root.action("page-browser");
                                        }
                                    }
                                }
                            }

                            select-popup := SelectPopup {
                                options: root.page-options;
                                element-x: root.page-select-x;
                                element-y: root.page-select-y;
                                element-width: root.page-select-width;
                                element-height: root.page-select-height;
                                area-width: page-area.width;
                                area-height: page-area.height;
                                chosen(index) => {
                                    root.page-select-chosen(index);
                                }
                            }

                            page-focus := FocusScope {
                                // Keys go to the page, except the window's own
                                // shortcuts (`window-key`), which go only to the
                                // window.
                                key-pressed(event) => {
                                    if root.window-key(event) {
                                        return reject;
                                    }
                                    if root.reload-key(event) {
                                        root.page-navigate("reload");
                                        return accept;
                                    }
                                    root.page-key(event.text, html-pane.mods(event.modifiers), true);
                                    accept
                                }
                                key-released(event) => {
                                    if root.window-key(event) || root.reload-key(event) {
                                        return reject;
                                    }
                                    root.page-key(event.text, html-pane.mods(event.modifiers), false);
                                    accept
                                }
                            }

                            TouchArea {
                                mouse-cursor: root.page-cursor == 1 ? MouseCursor.pointer : root.page-cursor == 2 ? MouseCursor.text : MouseCursor.default;
                                pointer-event(event) => {
                                    if event.kind == PointerEventKind.down {
                                        page-focus.focus();
                                    }
                                    if event.kind != PointerEventKind.cancel {
                                        root.page-pointer(
                                            event.kind == PointerEventKind.down ? 0 : event.kind == PointerEventKind.up ? 1 : 2,
                                            event.button == PointerEventButton.middle ? 1 : event.button == PointerEventButton.right ? 2 : event.button == PointerEventButton.back ? 3 : event.button == PointerEventButton.forward ? 4 : 0,
                                            self.mouse-x,
                                            self.mouse-y,
                                            html-pane.mods(event.modifiers));
                                    }
                                }
                                scroll-event(event) => {
                                    root.page-scroll(event.delta-x, event.delta-y, self.mouse-x, self.mouse-y);
                                    accept
                                }
                            }
                        }
                    }
                }
            }

            StatusBar {
                text: root.status-text;
                right-text: root.unread-text;
            }
        }
    }
}
