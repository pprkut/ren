import { Palette, ScrollView } from "std-widgets.slint";
import { FeedTree, FeedRow } from "feed_tree.slint";
import { ItemTable, ItemRow, ItemStatus } from "item_table.slint";
import { Splitter } from "splitter.slint";

export { FeedRow, ItemRow, ItemStatus }

// Where the item list goes relative to the article.
export enum Arrangement {
    // Item list left of the article, with compact two-line rows.
    beside,
    // Item list above the article, as a table (akregator's default).
    above,
}

export component MainWindow inherits Window {
    in property <[FeedRow]> feeds;
    in property <[ItemRow]> items;
    in-out property <int> current-feed: 0;
    in-out property <int> current-item: -1;
    in property <string> article-title;
    in property <string> article-meta;
    in property <string> article-body;
    in-out property <length> article-content-y <=> article.content-y;

    in-out property <Arrangement> arrangement: Arrangement.beside;
    // Pane sizes, changed by the splitters.
    in-out property <length> tree-width: 240px;
    in-out property <length> list-width: 420px;
    in-out property <length> list-height: 300px;

    // For the autoscroll measurement.
    in-out property <length> item-list-content-y <=> item-list.content-y;
    out property <length> item-list-scroll-range: item-list.scroll-range;
    in property <int> sort-column: 3;
    in property <bool> sort-ascending: false;

    callback feed-clicked(row: int);
    callback feed-toggled(row: int);
    callback feed-key(key: string);
    callback item-clicked(row: int);
    callback item-key(key: string, page: int);
    callback sort-clicked(column: int);

    title: "ren";
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Palette.background;

    HorizontalLayout {
        FeedTree {
            width: root.tree-width;
            rows: root.feeds;
            current: root.current-feed;
            select(row) => {
                root.feed-clicked(row);
            }
            toggle(row) => {
                root.feed-toggled(row);
            }
            navigate(key) => {
                root.feed-key(key);
            }
        }

        Splitter {
            width: 5px;
            size <=> root.tree-width;
            min-size: 150px;
            max-size: 600px;
        }

        // The item list and the article, arranged by hand so that both
        // arrangements share the same element instances (and with them
        // selection, focus and scroll positions).
        content := Rectangle {
            horizontal-stretch: 1;

            property <bool> beside: root.arrangement == Arrangement.beside;
            property <length> bar: 5px;

            item-list := ItemTable {
                x: 0px;
                y: 0px;
                width: content.beside ? root.list-width : content.width;
                height: content.beside ? content.height : root.list-height;
                compact: content.beside;
                rows: root.items;
                current: root.current-item;
                sort-column: root.sort-column;
                sort-ascending: root.sort-ascending;
                select(row) => {
                    root.item-clicked(row);
                }
                navigate(key, page) => {
                    root.item-key(key, page);
                }
                sort(column) => {
                    root.sort-clicked(column);
                }
            }

            Splitter {
                visible: content.beside;
                vertical: true;
                x: root.list-width;
                width: content.bar;
                height: content.height;
                size <=> root.list-width;
                min-size: 250px;
                max-size: content.width - 250px;
            }

            Splitter {
                visible: !content.beside;
                vertical: false;
                y: root.list-height;
                width: content.width;
                height: content.bar;
                size <=> root.list-height;
                min-size: 100px;
                max-size: content.height - 100px;
            }

            article := ScrollView {
                x: content.beside ? root.list-width + content.bar : 0px;
                y: content.beside ? 0px : root.list-height + content.bar;
                width: content.width - self.x;
                height: content.height - self.y;
                content-width: self.visible-width;
                content-height: article-layout.preferred-height;

                article-layout := VerticalLayout {
                    width: article.visible-width;
                    padding: 16px;
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: root.article-title;
                        wrap: word-wrap;
                        font-size: 1.5rem;
                        font-weight: 700;
                        color: Palette.foreground;
                    }

                    Text {
                        text: root.article-meta;
                        wrap: word-wrap;
                        color: Palette.foreground;
                        opacity: 0.7;
                    }

                    Text {
                        text: root.article-body;
                        wrap: word-wrap;
                        color: Palette.foreground;
                    }
                }
            }
        }
    }
}
