import { Button, ComboBox, LineEdit, Palette, ScrollView, Switch, TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";

// A setting as the dialog shows it, made from its descriptor.
export struct SettingRow {
    key: string,
    // The category's title above the first row of each category, while
    // searching.
    heading: string,
    title: string,
    description: string,
    // 0 switch, 1 choice, 2 number, 3 text, 4 colour, 5 list.
    kind: int,
    on: bool,
    options: [string],
    choice: int,
    // The text of a number, text, colour or list (one item per line).
    input: string,
    unit: string,
    placeholder: string,
    has-colour: bool,
    colour: color,
    // The file sets it, so it can be reset.
    modified: bool,
    // The switch it requires is on; else `requires` is that switch's
    // title.
    enabled: bool,
    requires: string,
    error: string,
}

// A category of the list on the left; while searching, its number of
// results (else -1).
export struct CategoryEntry {
    title: string,
    count: int,
}

// A flat button with a label.
component FlatButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();

    border-radius: Theme.selection-radius;
    background: !root.enabled ? transparent : touch.pressed ? Theme.selection(true) : touch.has-hover ? Theme.hover : transparent;
    opacity: root.enabled ? 1.0 : 0.45;
    min-width: label.preferred-width + 16px;
    min-height: label.preferred-height + 8px;

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }

    label := Text {
        text: root.text;
        vertical-alignment: center;
        horizontal-alignment: center;
        color: Palette.foreground;
    }
}

component CategoryItem inherits Rectangle {
    in property <string> text;
    in property <int> count: -1;
    in property <bool> selected;
    callback clicked();

    height: Theme.row-height + 4px;
    border-radius: Theme.selection-radius;
    background: root.selected ? Theme.selection(true) : touch.has-hover ? Theme.hover : transparent;

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        // No results while searching.
        opacity: root.count == 0 ? 0.45 : 1.0;

        Text {
            horizontal-stretch: 1;
            text: root.text;
            vertical-alignment: center;
            overflow: elide;
            color: Palette.foreground;
        }

        if root.count >= 0: Text {
            text: root.count;
            vertical-alignment: center;
            color: Palette.foreground;
            opacity: 0.7;
        }
    }
}

// One setting: title, description and key on the left, the control and a
// reset button on the right.
component SettingRowView inherits VerticalLayout {
    in property <SettingRow> setting;
    in property <bool> editable;
    callback toggled(on: bool);
    callback chosen(index: int);
    callback accepted(text: string);
    callback reset();

    // Controls can be changed: the file has no errors, and the switch the
    // setting requires is on.
    property <bool> active: root.editable && root.setting.enabled;

    spacing: 6px;

    if root.setting.heading != "": Text {
        text: root.setting.heading;
        font-size: 1.15rem;
        font-weight: 700;
        color: Palette.foreground;
    }

    HorizontalLayout {
        spacing: 16px;

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            alignment: start;
            opacity: root.setting.enabled ? 1.0 : 0.5;

            Text {
                text: root.setting.title;
                font-weight: 600;
                wrap: word-wrap;
                color: Palette.foreground;
            }

            Text {
                text: root.setting.description;
                wrap: word-wrap;
                color: Palette.foreground;
                opacity: 0.75;
            }

            Text {
                text: root.setting.key;
                font-size: 0.85rem;
                color: Palette.foreground;
                opacity: 0.5;
            }

            if !root.setting.enabled: Text {
                text: "Only with “" + root.setting.requires + "” on.";
                wrap: word-wrap;
                font-italic: true;
                color: Palette.foreground;
            }

            if root.setting.error != "": Text {
                text: root.setting.error;
                wrap: word-wrap;
                color: Theme.status-new;
            }
        }

        VerticalLayout {
            width: 280px;
            alignment: start;
            spacing: 4px;

            HorizontalLayout {
                spacing: 6px;
                alignment: end;

                if root.setting.kind == 0: Switch {
                    enabled: root.active;
                    checked: root.setting.on;
                    toggled => {
                        root.toggled(self.checked);
                    }
                    // The bindings to the row are gone once the user
                    // changed the control; the row's values are set again
                    // when they change.
                    property <bool> on: root.setting.on;
                    changed on => {
                        self.checked = self.on;
                    }
                }

                if root.setting.kind == 1: ComboBox {
                    horizontal-stretch: 1;
                    enabled: root.active;
                    model: root.setting.options;
                    current-index: root.setting.choice;
                    selected => {
                        root.chosen(self.current-index);
                    }
                    property <int> choice: root.setting.choice;
                    changed choice => {
                        self.current-index = self.choice;
                    }
                }

                if root.setting.kind == 4 && root.setting.has-colour: Rectangle {
                    width: 24px;
                    height: 24px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.separator;
                    background: root.setting.colour;
                }

                if root.setting.kind >= 2 && root.setting.kind <= 4: LineEdit {
                    horizontal-stretch: 1;
                    enabled: root.active;
                    text: root.setting.input;
                    placeholder-text: root.setting.placeholder;
                    accepted(text) => {
                        root.accepted(text);
                    }
                    // Applied when the focus leaves it, too.
                    changed has-focus => {
                        if !self.has-focus && self.text != root.setting.input {
                            root.accepted(self.text);
                        }
                    }
                    property <string> input: root.setting.input;
                    changed input => {
                        self.text = self.input;
                    }
                }

                if root.setting.kind == 2: Text {
                    width: 56px;
                    text: root.setting.unit;
                    vertical-alignment: center;
                    color: Palette.foreground;
                    opacity: 0.75;
                }
            }

            if root.setting.kind == 5: TextEdit {
                height: 110px;
                enabled: root.active;
                text: root.setting.input;
                wrap: no-wrap;
                changed has-focus => {
                    if !self.has-focus && self.text != root.setting.input {
                        root.accepted(self.text);
                    }
                }
                property <string> input: root.setting.input;
                changed input => {
                    self.text = self.input;
                }
            }

            if root.setting.kind == 5: Text {
                text: "One per line; applied when you leave the field.";
                font-size: 0.85rem;
                horizontal-alignment: right;
                color: Palette.foreground;
                opacity: 0.6;
            }

            if root.setting.modified: HorizontalLayout {
                alignment: end;

                FlatButton {
                    text: "Reset to Default";
                    enabled: root.active;
                    clicked => {
                        root.reset();
                    }
                }
            }
        }
    }

    Rectangle {
        height: 1px;
        background: Theme.separator;
    }
}

// The account page, made by hand: logged in, logging in (in the browser,
// or with an app password), or waiting for the browser.
component AccountPage inherits VerticalLayout {
    // 0 logged out, 1 waiting for the browser, 2 logged in, 3 busy.
    in property <int> state;
    in property <string> server;
    in property <string> user;
    // Who is logged in where, and where the app password comes from.
    in property <string> summary;
    in property <string> message;
    in property <bool> message-error;
    in property <string> login-url;
    in property <bool> editable;
    callback log-in-browser(server: string);
    callback log-in-password(server: string, user: string, password: string);
    callback open-login-url();
    callback cancel-login();
    callback log-out();

    spacing: 10px;

    Text {
        text: "Nextcloud account";
        font-size: 1.15rem;
        font-weight: 700;
        color: Palette.foreground;
    }

    if root.state == 2: VerticalLayout {
        spacing: 10px;

        HorizontalLayout {
            spacing: 16px;

            Text {
                horizontal-stretch: 1;
                text: root.summary;
                wrap: word-wrap;
                vertical-alignment: center;
                color: Palette.foreground;
            }

            Button {
                horizontal-stretch: 0;
                text: "Log Out";
                enabled: root.editable;
                clicked => {
                    root.log-out();
                }
            }
        }

        Text {
            text: "Logging out revokes ren's app password on the server and removes it from this computer. The articles stored here stay.";
            wrap: word-wrap;
            color: Palette.foreground;
            opacity: 0.75;
        }
    }

    if root.state == 1: VerticalLayout {
        spacing: 10px;

        Text {
            text: "Waiting for the browser… Log in to your Nextcloud in the page that opened, and grant ren access.";
            wrap: word-wrap;
            color: Palette.foreground;
        }

        Text {
            text: root.login-url;
            wrap: word-wrap;
            font-size: 0.85rem;
            color: Palette.foreground;
            opacity: 0.6;
        }

        HorizontalLayout {
            alignment: start;
            spacing: 8px;

            Button {
                text: "Open the Page Again";
                clicked => {
                    root.open-login-url();
                }
            }

            Button {
                text: "Cancel";
                clicked => {
                    root.cancel-login();
                }
            }
        }
    }

    if root.state == 0 || root.state == 3: VerticalLayout {
        spacing: 8px;

        Text {
            text: "Log in to your Nextcloud with the News app. Your browser opens its login page, where you can also use two-factor authentication or single sign-on; ren gets an app password of its own, which your Nextcloud lists under Security.";
            wrap: word-wrap;
            color: Palette.foreground;
            opacity: 0.75;
        }

        HorizontalLayout {
            spacing: 8px;

            server-field := LineEdit {
                horizontal-stretch: 1;
                enabled: root.state == 0 && root.editable;
                text: root.server;
                placeholder-text: "Server, e.g. cloud.example.org";
                accepted => {
                    root.log-in-browser(self.text);
                }
            }

            Button {
                text: "Log In in the Browser";
                primary: true;
                enabled: root.state == 0 && root.editable;
                clicked => {
                    root.log-in-browser(server-field.text);
                }
            }
        }

        Rectangle {
            height: 6px;
        }

        Text {
            text: "Or with an app password you created in your Nextcloud (Personal settings → Security → Devices & sessions):";
            wrap: word-wrap;
            color: Palette.foreground;
            opacity: 0.75;
        }

        HorizontalLayout {
            spacing: 8px;

            user-field := LineEdit {
                horizontal-stretch: 1;
                enabled: root.state == 0 && root.editable;
                text: root.user;
                placeholder-text: "Login name";
            }

            password-field := LineEdit {
                horizontal-stretch: 1;
                enabled: root.state == 0 && root.editable;
                input-type: password;
                placeholder-text: "App password";
                accepted => {
                    root.log-in-password(server-field.text, user-field.text, self.text);
                }
            }

            Button {
                text: "Log In";
                enabled: root.state == 0 && root.editable;
                clicked => {
                    root.log-in-password(server-field.text, user-field.text, password-field.text);
                }
            }
        }
    }

    if root.message != "": Text {
        text: root.message;
        wrap: word-wrap;
        color: root.message-error ? Theme.status-new : Palette.foreground;
    }

    Rectangle {
        height: 1px;
        background: Theme.separator;
    }
}

export component SettingsWindow inherits Window {
    in property <[CategoryEntry]> categories;
    // -1 while searching.
    in property <int> current-category;
    in property <[SettingRow]> rows;
    // Nothing matches the search.
    in property <bool> no-match;
    // Why the file can't be changed now (it has errors), or "".
    in property <string> problem;
    in property <bool> editable: true;
    in property <ColorScheme> forced-color-scheme: ColorScheme.unknown;

    // The account page, above the account's other settings.
    in property <bool> account-page;
    in property <int> account-state;
    in property <string> account-server;
    in property <string> account-user;
    in property <string> account-summary;
    in property <string> account-message;
    in property <bool> account-message-error;
    in property <string> login-url;
    callback log-in-browser(server: string);
    callback log-in-password(server: string, user: string, password: string);
    callback open-login-url();
    callback cancel-login();
    callback log-out();

    callback search-edited(text: string);
    callback category-selected(index: int);
    callback toggled(key: string, on: bool);
    callback chosen(key: string, index: int);
    callback input-accepted(key: string, text: string);
    callback reset(key: string);
    callback open-file();

    // Shows a category's settings from the start.
    public function scroll-to-top() {
        content.content-y = 0;
    }

    changed forced-color-scheme => {
        Palette.color-scheme = root.forced-color-scheme;
    }

    title: "Settings – ren";
    preferred-width: 920px;
    preferred-height: 660px;
    min-width: 640px;
    min-height: 400px;
    background: Palette.background;

    HorizontalLayout {
        Rectangle {
            width: 220px;
            background: Palette.alternate-background;

            VerticalLayout {
                padding: 10px;
                spacing: 4px;

                search := LineEdit {
                    placeholder-text: "Search settings…";
                    edited(text) => {
                        root.search-edited(text);
                    }
                }

                Rectangle {
                    height: 6px;
                }

                for category[index] in root.categories: CategoryItem {
                    text: category.title;
                    count: category.count;
                    selected: index == root.current-category;
                    clicked => {
                        root.category-selected(index);
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                }

                Button {
                    text: "Open Settings File";
                    clicked => {
                        root.open-file();
                    }
                }
            }

            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Theme.separator;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;

            if root.problem != "": Rectangle {
                background: Theme.status-new.with-alpha(0.15);

                VerticalLayout {
                    padding: 10px;

                    Text {
                        text: root.problem;
                        wrap: word-wrap;
                        color: Palette.foreground;
                    }
                }
            }

            content := ScrollView {
                vertical-stretch: 1;
                content-width: self.visible-width;
                content-height: rows-layout.preferred-height;

                rows-layout := VerticalLayout {
                    width: content.visible-width;
                    padding: 20px;
                    spacing: 14px;
                    alignment: start;

                    if root.account-page: AccountPage {
                        state: root.account-state;
                        server: root.account-server;
                        user: root.account-user;
                        summary: root.account-summary;
                        message: root.account-message;
                        message-error: root.account-message-error;
                        login-url: root.login-url;
                        editable: root.editable;
                        log-in-browser(server) => {
                            root.log-in-browser(server);
                        }
                        log-in-password(server, user, password) => {
                            root.log-in-password(server, user, password);
                        }
                        open-login-url => {
                            root.open-login-url();
                        }
                        cancel-login => {
                            root.cancel-login();
                        }
                        log-out => {
                            root.log-out();
                        }
                    }

                    if root.no-match: Text {
                        text: "No settings match the search.";
                        color: Palette.foreground;
                        opacity: 0.75;
                    }

                    for row in root.rows: SettingRowView {
                        setting: row;
                        editable: root.editable;
                        toggled(on) => {
                            root.toggled(row.key, on);
                        }
                        chosen(index) => {
                            root.chosen(row.key, index);
                        }
                        accepted(text) => {
                            root.input-accepted(row.key, text);
                        }
                        reset => {
                            root.reset(row.key);
                        }
                    }
                }
            }
        }
    }
}
