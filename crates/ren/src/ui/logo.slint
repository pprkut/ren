// Ren's logo, a wire-frame lotus (蓮, ren): for 48 pixels and up, and
// without its wires for less (the windows' icons, which window managers
// show small).
export global Logo {
    out property <image> large: @image-url("../../icons/ren.svg");
    out property <image> small: @image-url("../../icons/ren-small.svg");
}
