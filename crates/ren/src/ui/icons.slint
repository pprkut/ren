// Icons, loaded at startup from the desktop's icon theme, or from the
// bundled monochrome set if the theme doesn't have them.
export global Icons {
    in property <image> add-feed;
    in property <image> fetch-feed;
    in property <image> fetch-all;
    in property <image> cancel;
    in property <image> mark-read;
    in property <image> quit;
    in property <image> find;
    in property <image> configure;

    // Feed tree
    in property <image> all-items;
    in property <image> starred;
    in property <image> folder;
    in property <image> feed;

    // Web pages
    in property <image> back;
    in property <image> forward;
    in property <image> reload;
    in property <image> browser;

    // The bundled icons are drawn in black and need the text colour.
    in property <bool> monochrome;
}
