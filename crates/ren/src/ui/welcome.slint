import { Button, Palette, ScrollView } from "std-widgets.slint";
import { Logo } from "logo.slint";

// Shown in the article pane while no article is, as in KDE's applications:
// Ren's name and version, the counts and the last sync, and without an
// account a button to log in, over the logo, faint, in the middle. Drawn
// by Slint, so it doesn't make the article view (Blitz) at the start.
export component WelcomePage inherits Rectangle {
    in property <string> version;
    // The unread articles, and what the last sync did.
    in property <string> articles;
    in property <string> sync;
    // An account is set up: no button to log in.
    in property <bool> logged-in;
    // "account": the button to log in.
    callback action(name: string);

    background: Palette.background;
    clip: true;

    Image {
        property <length> side: min(parent.width, parent.height) * 0.6;
        x: (parent.width - self.side) / 2;
        y: (parent.height - self.side) / 2;
        width: self.side;
        height: self.side;
        source: Logo.large;
        opacity: 0.08;
    }

    ScrollView {
        VerticalLayout {
            padding: 32px;
            spacing: 10px;
            alignment: start;

            Text {
                text: "Welcome to Ren";
                font-size: 2rem;
                font-weight: 700;
                color: Palette.foreground;
            }

            Text {
                text: "Version " + root.version + " · A native Nextcloud News reader";
                color: Palette.foreground;
                opacity: 0.75;
            }

            Rectangle {
                height: 6px;
            }

            Text {
                text: root.articles;
                wrap: word-wrap;
                font-size: 1.1rem;
                color: Palette.foreground;
            }

            Text {
                text: root.sync;
                wrap: word-wrap;
                color: Palette.foreground;
            }

            if !root.logged-in: Rectangle {
                height: 6px;
            }

            if !root.logged-in: HorizontalLayout {
                alignment: start;

                Button {
                    text: "Log In to Your Nextcloud…";
                    primary: true;
                    clicked => {
                        root.action("account");
                    }
                }
            }
        }
    }
}
