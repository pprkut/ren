# https://EditorConfig.org

root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

[{*.rs,*.slint,*.toml,*.sh,*.py,justfile}]
indent_style = space
indent_size = 4

[{*.yml,*.yaml}]
indent_style = space
indent_size = 2

[{*.md,*.html,*.svg,*.xml}]
indent_style = space

# Not ours to format: the licence texts, the generated notices, the feeds'
# data in the fixtures.
[{LICENSES/**,THIRD-PARTY-NOTICES.html,crates/nextcloud-news/tests/fixtures/**}]
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
